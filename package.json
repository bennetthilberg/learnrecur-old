{
  "name": "learnrecur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names next,jobs --prefix-colors blue,green \"next dev\" \"npm run jobs:dev\"",
    "dev:app": "next dev",
    "env:check": "tsx scripts/check-production-env.ts --strict",
    "check:runtime-audit": "tsx scripts/check-runtime-audit.ts",
    "eval:ai-generation": "NODE_OPTIONS='--conditions=react-server' tsx scripts/ai-generation-eval.ts",
    "agent:workos-gate": "tsx scripts/verify-workos-mcp-gate.ts",
    "prebuild": "tsx scripts/check-production-env.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/export-aws-worker-configuration.ts",
    "build": "next build",
    "vercel:build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint",
    "ops": "NODE_OPTIONS='--conditions=react-server' tsx scripts/ops.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:db": "RUN_DATABASE_TESTS=1 vitest run tests/integration",
    "test:e2e": "playwright test --project=anonymous-chromium",
    "test:e2e:auth": "playwright test --project=authenticated-chromium",
    "test:e2e:all": "playwright test --project=anonymous-chromium --project=authenticated-chromium",
    "test:e2e:db:prepare": "tsx scripts/manage-e2e-database.ts prepare",
    "test:e2e:db:cleanup": "tsx scripts/manage-e2e-database.ts cleanup",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e:all",
    "test:coverage": "RUN_DATABASE_TESTS=1 vitest run tests/unit tests/integration --coverage",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "tsx scripts/deploy-prisma-migrations.ts",
    "jobs:build": "tsx scripts/build-aws-jobs.ts",
    "jobs:dev": "NODE_OPTIONS='--conditions=react-server' tsx watch scripts/jobs-dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/client-sqs": "^3.1138.0",
    "@aws-sdk/client-ssm": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@clerk/backend": "3.18.1",
    "@clerk/nextjs": "^7.9.4",
    "@clerk/ui": "1.33.1",
    "@cortex-js/compute-engine": "^0.133.0",
    "@google/genai": "2.24.0",
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/notifications": "9.6.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@workos-inc/node": "10.13.0",
    "cheerio": "^1.2.0",
    "jose": "6.2.12",
    "katex": "0.18.7",
    "mcp-handler": "2.2.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.2",
    "undici": "8.11.0",
    "ws": "^8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.36",
    "@playwright/test": "1.63.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "ae-cvss-calculator": "1.0.13",
    "concurrently": "10.0.5",
    "dotenv": "18.0.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "postcss": "8.5.28",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "@hono/node-server": "1.19.15",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "brace-expansion": "1.1.18",
    "browserslist": "4.28.8",
    "jayson": {
      "stream-json": "3.6.0",
      "uuid": "11.1.1"
    },
    "metro": "0.87.1",
    "metro-config": "0.87.1",
    "metro-transform-worker": "0.87.1",
    "postcss": "8.5.28",
    "protobufjs": "7.6.5",
    "shell-quote": "1.10.0",
    "sharp": "0.35.4",
    "ws": "$ws",
    "hono": "4.13.7"
  }
}
